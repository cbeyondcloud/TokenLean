{
  "title": "Token Optimisation - Live Calls",
  "uid": "token-opt-live",
  "tags": [
    "token-optimisation",
    "live"
  ],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(token_opt_requests_total{tenant_id=~\"$tenant\"}[$__range]))",
          "instant": true,
          "legendFormat": "requests"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(token_opt_requests_total{tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(token_opt_cache_hits_total{tenant_id=~\"$tenant\"}[5m])) or vector(0)) / (sum(rate(token_opt_requests_total{tenant_id=~\"$tenant\"}[5m])) or vector(1)) * 100",
          "legendFormat": "hit rate %",
          "instant": false
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Saving %",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(token_opt_savings_pct_sum[$__range])) / sum(increase(token_opt_savings_pct_count[$__range]))",
          "format": "time_series",
          "legendFormat": "Avg Saving %",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Teams",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (team)(increase(token_opt_requests_total[$__range]) > 0))",
          "instant": true,
          "legendFormat": "active teams"
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cost (USD)",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(token_opt_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "cost USD"
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 17,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests / min - All Users",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(token_opt_requests_total[1m])) * 60",
          "legendFormat": "all users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests / min - by Team",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (team) (rate(token_opt_requests_total[1m])) * 60",
          "legendFormat": "{{team}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Token Savings % (rolling)",
      "description": "From usage_events: billable requests (an admin acting as a tenant, and error rows, are not counted).",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "app-postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('minute', timestamp) AS time, ROUND(AVG(CASE WHEN baseline_tokens = 0 THEN 0 ELSE tokens_saved * 100.0 / baseline_tokens END)::numeric, 1) AS avg_saving_pct FROM usage_events WHERE $__timeFilter(timestamp) AND COALESCE(billable, true) AND ('${tenant}' = '.*' OR tenant_id = '${tenant}') AND ('${team}' = '.*' OR COALESCE(NULLIF(team, ''), 'default') = '${team}') GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "app-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Per-Group Token Savings (live, by G0X)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (group) (rate(token_opt_group_tokens_saved_total[5m])) * 300",
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Active Users (by calls)",
      "description": "From usage_events: billable requests (an admin acting as a tenant, and error rows, are not counted).",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "app-postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT user_id, COUNT(*) AS calls FROM usage_events WHERE $__timeFilter(timestamp) AND COALESCE(billable, true) AND ('${tenant}' = '.*' OR tenant_id = '${tenant}') AND ('${team}' = '.*' OR COALESCE(NULLIF(team, ''), 'default') = '${team}') GROUP BY 1 ORDER BY calls DESC LIMIT 20",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "app-postgres"
          }
        }
      ],
      "options": {
        "barWidth": 0.4,
        "showValue": "always",
        "orientation": "auto",
        "text": {
          "valueSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Last 50 Calls",
      "description": "From usage_events: billable requests (an admin acting as a tenant, and error rows, are not counted). Cost saved includes the estimated input cost a cache hit avoided.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "app-postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp AS \"Time\", request_id AS \"Request ID\", user_id AS \"User\", routed_model AS \"Model\", baseline_tokens AS \"Baseline Tokens\", optimised_tokens AS \"Tokens Sent\", ROUND((CASE WHEN baseline_tokens = 0 THEN 0 ELSE tokens_saved * 100.0 / baseline_tokens END)::numeric, 1) AS \"Saving %\", ROUND(cost_saved_usd, 6) AS \"Cost Saved ($)\", CASE WHEN cache_hit THEN cache_level ELSE 'miss' END AS \"Cache\", CASE WHEN bypassed THEN 'yes' ELSE 'no' END AS \"Bypassed\" FROM usage_events WHERE COALESCE(billable, true) AND ('${tenant}' = '.*' OR tenant_id = '${tenant}') AND ('${team}' = '.*' OR COALESCE(NULLIF(team, ''), 'default') = '${team}') ORDER BY timestamp DESC LIMIT 50",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "app-postgres"
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ],
        "cellHeight": "md"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "user_id",
        "type": "query",
        "label": "User",
        "datasource": {
          "type": "postgres",
          "uid": "app-postgres"
        },
        "query": "SELECT DISTINCT user_id FROM usage_events WHERE timestamp >= NOW() - INTERVAL '24 hours' AND user_id <> '' ORDER BY 1",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant",
        "datasource": {
          "uid": "prometheus"
        },
        "definition": "label_values(token_opt_requests_total, tenant_id)",
        "query": "label_values(token_opt_requests_total, tenant_id)",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "refresh": 2
      },
      {
        "name": "team",
        "type": "query",
        "label": "Team",
        "description": "The authenticated team (usage_events.team; 'default' = no team, which also covers rows written before teams existed). Filters every panel that reads usage_events; Prometheus panels are not filtered by team.",
        "datasource": {
          "type": "postgres",
          "uid": "app-postgres"
        },
        "definition": "SELECT DISTINCT COALESCE(NULLIF(team, ''), 'default') AS team FROM usage_events WHERE $__timeFilter(timestamp) AND ('${tenant}' = '.*' OR tenant_id = '${tenant}') ORDER BY 1",
        "query": "SELECT DISTINCT COALESCE(NULLIF(team, ''), 'default') AS team FROM usage_events WHERE $__timeFilter(timestamp) AND ('${tenant}' = '.*' OR tenant_id = '${tenant}') ORDER BY 1",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  }
}