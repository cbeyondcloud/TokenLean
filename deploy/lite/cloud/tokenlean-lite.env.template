# TokenLean LITE on a cloud: the proxy container's environment, with a MANAGED Postgres and
# Redis (Cloud SQL / RDS / Azure Database for PostgreSQL; Memorystore / ElastiCache / Azure
# Cache for Redis, or any Postgres 15+ and Redis 7.2 you run). Use it as the env file of any
# container platform today; the Helm chart (planned) renders the same variables from
# values/managed.yaml. Copy it, fill the empty values from your secret store, and keep the
# filled copy out of git. One KEY=value per line, no quotes.
#
# The image: the OSS proxy image built from src/proxy/Dockerfile (or your registry's copy).
# Mounted into it, read-only:
#   /app/config        <- config/ of this repository (the shipped config.yaml.template)
#   /app/lite/config   <- deploy/lite/config/ (the LITE profile, plus your own overlays)
#   /app/lite/state    <- a secret holding local-keys.json: the bootstrap proxy keys, hashes
#                         only (scripts/generate_proxy_key.py or issue-key.sh). They are copied
#                         into Postgres once, into an empty proxy_keys table; after that, keys
#                         are issued, revoked and rotated through /admin/keys.

# -- Proxy --------------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
CONFIG_LOCAL_PATH=/app/config/config.yaml.template
# The LITE profile first, then your overlays (comma-separated paths inside the container).
CONFIG_OVERLAYS=/app/lite/config/agentic.yaml
STORAGE_BACKEND=local
LOCAL_PROXY_KEYS_FILE=/app/lite/state/local-keys.json

# -- Managed Postgres (usage_events, audit_events, proxy_keys, the routing overlay) -------
# Secret. Form: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# A role that may create tables in its schema lets the proxy create and update its own tables
# at startup, as the local stack does. With a restricted runtime role, apply the SQL files of
# infra/migrations/ as the tables' owner first; the proxy then skips its schema steps.
DATABASE_URL=

# -- Managed Redis (rate limits, spend counters, exact-match cache) -------------------------
# TLS (rediss://). The password stays out of the URL, in REDIS_PASSWORD.
REDIS_URL=rediss://REDIS_HOST:6380/0
REDIS_PASSWORD=
# The CA that signs the Redis certificate, PEM, when it is not in the system trust store
# (a private CA). Empty: the system trust store verifies it.
REDIS_CA_CERT=

# -- Metrics ------------------------------------------------------------------
# /metrics answers only to this bearer token (your Prometheus presents it).
METRICS_SCRAPE_TOKEN=
METRICS_ALLOW_UNAUTHENTICATED=false

# -- Browser access (only if a browser app calls the proxy directly) ----------
CORS_ORIGINS=

# -- Provider keys (set the ones you use; the model name picks the provider) --
LLM_KEY_OPENAI=
LLM_KEY_ANTHROPIC=
LLM_KEY_GOOGLE=
LLM_KEY_GEMINI=
LLM_KEY_MISTRAL=
LLM_KEY_COHERE=
LLM_KEY_DEEPSEEK=
LLM_KEY_XAI=
LLM_KEY_GROQ=
LLM_KEY_OPENROUTER=
LLM_KEY_OPENCODE=
LLM_KEY_AZURE=
