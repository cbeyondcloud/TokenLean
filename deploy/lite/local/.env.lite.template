# TokenLean LITE - local settings.
# up.sh / up.ps1 copy this file to .env.lite (git-ignored) on first run and fill every EMPTY
# value in the "Generated" block. Edit .env.lite, not this file. One KEY=value per line, no
# quotes, no spaces around '='.

# -- Network ------------------------------------------------------------------
# Address the published ports bind to. 127.0.0.1 = this machine only.
LITE_BIND=127.0.0.1
LITE_PROXY_PORT=4100
LITE_LANGFUSE_PORT=3110
LITE_GRAFANA_PORT=3120

# -- Tenant -------------------------------------------------------------------
# The tenant the generated proxy keys belong to (usage rows and limits are per tenant).
LITE_TENANT_ID=LITE-LOC-01

# -- Provider keys ------------------------------------------------------------
# Set the ones you use; leave the rest empty. Any provider TokenLean supports works, and the
# model name in each request picks the provider. Not needed for `up --mock`.
LLM_KEY_OPENAI=
LLM_KEY_ANTHROPIC=
LLM_KEY_GEMINI=
LLM_KEY_GOOGLE=
LLM_KEY_MISTRAL=
LLM_KEY_COHERE=
LLM_KEY_DEEPSEEK=
LLM_KEY_XAI=
LLM_KEY_GROQ=
LLM_KEY_OPENROUTER=
LLM_KEY_OPENCODE=
LLM_KEY_AZURE=

# -- Generated (leave empty; up fills them once and keeps them) ----------------
# Proxy keys: send TOKENLEAN_API_KEY as `Authorization: Bearer ...` (or `x-api-key` on
# /v1/messages). The admin key may call the /admin/* endpoints.
TOKENLEAN_API_KEY=
TOKENLEAN_ADMIN_KEY=
DB_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
METRICS_SCRAPE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_INIT_USER_PASSWORD=
# Grafana's `admin` login (up --grafana).
GRAFANA_ADMIN_PASSWORD=

# -- Optional -----------------------------------------------------------------
# A pre-built proxy image (e.g. from your registry) instead of building src/proxy locally.
TOKENLEAN_IMAGE=
# More overlays applied after the LITE profile: comma-separated paths INSIDE the container.
# Mount your own files under deploy/lite/config/ (seen as /app/lite/config/...).
LITE_EXTRA_OVERLAYS=
# Langfuse admin login (with the generated LANGFUSE_INIT_USER_PASSWORD).
LANGFUSE_INIT_USER_EMAIL=admin@lite.local
# Seconds `up` waits for the proxy to report healthy.
LITE_HEALTH_TIMEOUT=240
