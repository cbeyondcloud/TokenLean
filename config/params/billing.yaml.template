billing:
  # Request-count metering to the Postgres `usage_events` table. Metering runs
  # unconditionally in main.py once DATABASE_URL is set. This flag is not read: it
  # gated a G18 meter path that was never given a meter, removed 2026-10-01.
  enabled: false
  # The request-count rate card (`rate_card:`) and the legacy tier map live in the
  # commercial-only config/params/tiers.yaml.template, merged back under `billing:`
  # in private builds and simply absent in OSS. OpenMeter was removed (2026-07-02):
  # its push in metering.py is a dormant no-op configured via env vars, never here.
  metering:
    # C1 — persist the per-G-group realised savings JSONB on each usage_events row so
    # the "savings by optimisation" panel works from the indexed table (not Langfuse).
    # Set false to drop the extra JSONB write on the hot insert path.
    group_savings_enabled: true
    # C2 — persist an observability-only row for non-2xx outcomes (billable=false) so the
    # in-dashboard latency-percentile + error-rate panels have data. These rows are
    # EXCLUDED from the request-count invoice. Set false to restore the old 2xx-only write.
    persist_all_outcomes: true
    # Usage tags: allow-listed request headers stored as a JSONB object in
    # usage_events.tags, so a caller can attribute cost to its own dimensions (run, step,
    # agent, ...). Only the headers listed below are recorded; any other header is ignored.
    # Values are trimmed, cut to max_value_chars, must be printable ASCII, and a value that
    # looks like a credential is dropped (counted in token_opt_usage_tags_dropped_total).
    # Read from this global config only: a tenant cannot change what is recorded. The tags
    # are caller-asserted and select nothing (usage_events.team is the authenticated team).
    # `headers` replaces the default list below entirely; `{}` records nothing.
    tags:
      enabled: true
      max_value_chars: 256          # at most 1024
      headers:                      # request header -> tag key ([a-z][a-z0-9_]*)
        X-Agentic-Team: team
        X-Agentic-User: user
        X-Agentic-Repo: repo
        X-Agentic-Pipeline: pipeline
        X-Agentic-Run-Id: run_id
        X-Agentic-Step: step
        X-Agentic-Agent: agent
        X-Agentic-Parent-Agent: parent_agent
        X-Agentic-Tier: tier
        X-Agentic-Policy-Version: policy_version
